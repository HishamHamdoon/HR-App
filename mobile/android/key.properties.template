# Release signing config. Copy to `key.properties` (git-ignored) and fill in real values.
# Create the keystore with:
#   keytool -genkey -v -keystore hr-app-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias hr-app
# storeFile is resolved relative to the android/app directory.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=hr-app
storeFile=../hr-app-release.jks
